{
  "name": "harness-studio",
  "version": "0.1.12",
  "description": "Harness Studio — a focused, feature-rich desktop workspace for DeepSeek Harness.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Harness Studio Contributors"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/yunhanhai/harness-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunhanhai/harness-studio.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && node scripts/check-preload.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:workspace-navigation": "node scripts/test-workspace-navigation.mjs",
    "test:plugin-navigation": "node scripts/test-plugin-navigation.mjs",
    "test:model-navigation": "node scripts/test-model-navigation.mjs && node scripts/test-model-setup-settings.mjs",
    "test:skills": "node scripts/test-skills.mjs && node scripts/test-skills-launch-context.mjs",
    "test:session-tab-focus": "node scripts/test-session-tab-focus.mjs",
    "test:conversation-font": "node scripts/test-conversation-font-settings.mjs && node scripts/test-conversation-font-preload.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:runtime": "node scripts/test-runtime-compatibility.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview:ui": "node scripts/preview-server.mjs",
    "dist": "electron-vite build && node scripts/check-preload.mjs && electron-builder --win",
    "dist:dir": "electron-vite build && node scripts/check-preload.mjs && electron-builder --win --dir",
    "dist:portable": "electron-vite build && node scripts/check-preload.mjs && electron-builder --win portable",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "clean:dist": "node scripts/clean-dist.mjs",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status.ps1",
    "test:gitee-sync": "node scripts/test-gitee-sync.mjs",
    "test:upstream:skills": "node scripts/test-skills-native-parser.mjs",
    "test:upstream:adapter": "node scripts/test-upstream-model-adapter.mjs",
    "test:upstream:electron": "node scripts/test-upstream-electron.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
