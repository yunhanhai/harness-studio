{
  "name": "harness-studio",
  "version": "0.1.0",
  "description": "Harness Studio — a focused, feature-rich desktop workspace for DeepSeek Harness.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Harness Studio Contributors"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/yunhanhai/harness-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunhanhai/harness-studio.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icons": "node scripts/generate-icons.mjs",
    "preview:ui": "node scripts/preview-server.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
